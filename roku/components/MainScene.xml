            <Label id="userLabel" translation="[0,220]" text="Username" color="#D8D8D8" />
            <TextEditBox id="userBox" translation="[0,245]" width="650" height="52" />

            <Label id="passLabel" translation="[0,315]" text="Password" color="#D8D8D8" />
